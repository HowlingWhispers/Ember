# Ember only. Do not put credentials in browser source or localStorage.
NODE_ENV=production
EMBER_PORT=8794
# Use the same secret configured on the Orbis API server.
EMBER_BRIDGE_SECRET=
# Local Orbis API loopback port, never the public website address.
ORBIS_INTERNAL_URL=http://127.0.0.1:8789
ORBIS_WEB_ORIGIN=https://lib.thehowlingwhispers.com

# Opt-in temporary Ember accounts until HW-Landing provides shared accounts.
# Set only after assigning a private, service-owned directory and generated encryption key.
# Local V2 cards and story files remain browser-only, not in the vault.
EMBER_GUEST_ENABLED=0
EMBER_GUEST_DATA_DIR=/var/lib/hw-ember/guest
# 32 random bytes, hex encoded. Never reuse ORBIS_CREDENTIAL_ENCRYPTION_KEY.
EMBER_GUEST_ENCRYPTION_KEY=
EMBER_WEB_ORIGIN=https://thehowlingwhispers.com
